{
  "version": "2.0.0",
  "project": "predictive-maintenance-transit",
  "dataset": {
    "source": "NASA C-MAPSS FD001",
    "url": "https://ti.arc.nasa.gov/tech/dash/groups/pcoe/prognostic-data-repository/",
    "records": 20631,
    "engines_train": 100,
    "engines_test": 100,
    "sensors": 14,
    "last_updated": "2008-10-01",
    "citation": "A. Saxena et al., PHM08, Denver CO, 2008"
  },
  "models": {
    "mean_rul_baseline": {
      "mae_cycles": 40.7,
      "rmse_cycles": 52.3,
      "r2": -0.59,
      "notes": "Predict mean training RUL for all engines \u2014 simplest credible baseline"
    },
    "random_forest": {
      "mae_cycles": 24.3,
      "rmse_cycles": 35.5,
      "r2": 0.27,
      "notes": "Ensemble model; strong baseline performance"
    },
    "xgboost": {
      "mae_cycles": 26.2,
      "rmse_cycles": 36.8,
      "r2": 0.22,
      "notes": "Best performer; gradient boosting with engineered features"
    }
  },
  "feature_engineering": {
    "rolling_window": 10,
    "normalization": "standard-scaler",
    "dropped_sensors": [
      "sensor_1",
      "sensor_5",
      "sensor_6",
      "sensor_10",
      "sensor_16",
      "sensor_18",
      "sensor_19"
    ],
    "top_features": [
      "sensor_4_mean",
      "sensor_21_mean",
      "sensor_15_mean",
      "sensor_9_mean",
      "sensor_3_mean"
    ]
  },
  "figures": [
    "feature_importance.png",
    "predicted_vs_actual_rul.png",
    "rul_degradation_trajectories.png",
    "rul_distributions.png",
    "rul_residuals.png",
    "sensor_degradation_curves.png",
    "sensor_rul_correlation.png"
  ],
  "notebooks": [
    "predictive_maintenance_analysis.ipynb"
  ],
  "status": "complete",
  "executed": true,
  "execution_date": "2026-05-30",
  "execution_environment": "Python 3.12, scikit-learn 1.8, XGBoost 3.2",
  "validation": "Train/test split on engine IDs. No data leakage."
}